{
  "manifest_version": 3,
  "name": "Chat Conversation Exporter",
  "version": "1.4.0",
  "description": "Export the current ChatGPT or Claude conversation to Markdown, JSON, or text.",
  "permissions": ["activeTab", "clipboardWrite", "downloads"],
  "action": {
    "default_title": "Export conversation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["shared.js", "chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shared.js", "claude.js"],
      "run_at": "document_idle"
    }
  ]
}
